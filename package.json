{
  "name": "karaoke-chrome-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:content": "cross-env TARGET=content vite build",
    "build:background": "cross-env TARGET=background vite build",
    "build": "npm run build:content && npm run build:background",
    "test": "cross-env NODE_OPTIONS=--experimental-require-module vitest run",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-require-module vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.6",
    "@types/node": "^26.2.0",
    "cross-env": "^10.1.0",
    "jsdom": "^27.0.1",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
